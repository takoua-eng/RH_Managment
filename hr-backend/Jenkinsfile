// =====================================================================
// Pipeline CI/CD du backend RH (Spring Boot, WAR, Tomcat)
// Tests → qualité du code → image Docker → Nexus → Kubernetes
// =====================================================================
pipeline {
    agent any

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
        timeout(time: 40, unit: 'MINUTES')
    }

    triggers {
        // Vérifie toutes les 5 minutes s'il y a de nouveaux commits sur GitHub
        pollSCM('H/5 * * * *')
    }

    environment {
        REGISTRY  = '192.168.255.129:8082'
        IMAGE     = "${REGISTRY}/hr-backend"
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        SONAR_URL = 'http://192.168.255.129:9000'
    }

    stages {

        stage('Compilation et tests') {
            steps {
                dir('hr-backend') {
                    sh 'chmod +x mvnw'
                    // Un test en échec arrête le pipeline
                    sh """
                        ./mvnw -B clean verify \
                          -Dtest='!HrBackendApplicationTests' \
                          -Dsurefire.failIfNoSpecifiedTests=false
                    """
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'hr-backend/target/surefire-reports/*.xml'
                }
            }
        }

        stage('Vérification de SonarQube') {
            // SonarQube est démarré à la demande : on vérifie s'il est disponible
            steps {
                script {
                    def code = sh(
                        script: "curl -sf ${SONAR_URL}/api/system/status | grep -q '\"status\":\"UP\"'",
                        returnStatus: true
                    )
                    env.SONAR_UP = (code == 0) ? 'true' : 'false'
                    echo(env.SONAR_UP == 'true'
                        ? 'SonarQube est disponible : analyse de la qualité du code'
                        : 'SonarQube est arrêté : analyse ignorée pour ce build')
                }
            }
        }

        stage('Analyse SonarQube') {
            when { environment name: 'SONAR_UP', value: 'true' }
            steps {
                dir('hr-backend') {
                    withSonarQubeEnv('sonarqube') {
                        sh '''
                            ./mvnw -B sonar:sonar \
                              -Dsonar.projectKey=hr-backend \
                              -Dsonar.projectName="CorpFlow HR - Backend" \
                              -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml
                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {
            when { environment name: 'SONAR_UP', value: 'true' }
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    // abortPipeline: false → le verdict est affiché, sans bloquer le déploiement
                    waitForQualityGate abortPipeline: false
                }
            }
        }

        stage('Archivage du WAR') {
            steps {
                archiveArtifacts artifacts: 'hr-backend/target/hr-backend.war', fingerprint: true
            }
        }

        stage('Image Docker') {
            steps {
                dir('hr-backend') {
                    sh 'docker build -t "$IMAGE:$IMAGE_TAG" -t "$IMAGE:latest" .'
                }
            }
        }

        stage('Envoi vers Nexus') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'nexus-docker',
                                                  usernameVariable: 'NEXUS_USER',
                                                  passwordVariable: 'NEXUS_PWD')]) {
                    sh '''
                        echo "$NEXUS_PWD" | docker login "$REGISTRY" -u "$NEXUS_USER" --password-stdin
                        docker push -q "$IMAGE:$IMAGE_TAG"
                        docker push -q "$IMAGE:latest"
                    '''
                }
            }
        }

        stage('Déploiement Kubernetes') {
            steps {
                withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                    sh '''
                        # Nouvelle version de l'image, identifiée par le numéro du build
                        kubectl -n hr-platform set image deployment/hr-backend hr-backend="$IMAGE:$IMAGE_TAG"

                        # Attend que la nouvelle version soit prête ; sinon, retour à la précédente
                        if ! kubectl -n hr-platform rollout status deployment/hr-backend --timeout=300s; then
                            echo "Échec du déploiement : retour à la version précédente"
                            kubectl -n hr-platform rollout undo deployment/hr-backend
                            exit 1
                        fi
                    '''
                }
            }
        }
    }

    post {
        always {
            sh 'docker logout "$REGISTRY" || true'
            sh 'docker rmi "$IMAGE:$IMAGE_TAG" "$IMAGE:latest" || true'
        }
        success {
            echo "Version ${IMAGE_TAG} testée, analysée, publiée et déployée"
        }
    }
}
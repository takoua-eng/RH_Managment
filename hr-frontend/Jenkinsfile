// =====================================================================
// Pipeline CI/CD du frontend (Angular compilé avec Node.js, servi par Nginx)
// Même logique que le backend : compilation → qualité → livrable → image
// → test de fumée → Nexus → Kubernetes
// =====================================================================

def sonarDisponible(String url) {
    return sh(script: "curl -sf ${url}/api/system/status | grep -q '\"status\":\"UP\"'",
              returnStatus: true) == 0
}

pipeline {
    agent any

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '10', artifactNumToKeepStr: '3'))
        disableConcurrentBuilds()
        timeout(time: 40, unit: 'MINUTES')
    }

    triggers {
        pollSCM('H/5 * * * *')
    }

    environment {
        REGISTRY        = '192.168.255.129:8082'
        IMAGE           = "${REGISTRY}/hr-frontend"
        BUILD_IMAGE     = "hr-frontend-compilation:${env.BUILD_NUMBER}"
        BUILD_CONTAINER = "hr-frontend-livrable-${env.BUILD_NUMBER}"
        TEST_CONTAINER  = "hr-frontend-test-${env.BUILD_NUMBER}"
        SONAR_URL       = 'http://192.168.255.129:9000'
    }

    stages {

        stage('Préparation') {
            steps {
                script {
                    env.IMAGE_TAG = "${env.BUILD_NUMBER}-${env.GIT_COMMIT.take(7)}"
                    env.SONAR_UP  = sonarDisponible(env.SONAR_URL) ? 'true' : 'false'
                    echo "Version de l'image : ${env.IMAGE_TAG}"
                    echo(env.SONAR_UP == 'true' ? 'SonarQube disponible' : 'SonarQube arrêté : analyse ignorée')
                }
            }
        }

        stage('Compilation et tests') {
            steps {
                dir('hr-frontend') {
                    // Étape de compilation du Dockerfile seule (Node.js) : dépendances, compilation
                    // de production et vérification que index.html est bien produit
                    sh 'docker build --target build -t "$BUILD_IMAGE" .'
                }
            }
        }

        stage('Analyse SonarQube') {
            when { environment name: 'SONAR_UP', value: 'true' }
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    dir('hr-frontend') {
                        withSonarQubeEnv('sonarqube') {
                            sh '''
                                docker run --rm \
                                  --memory 2g \
                                  -u "$(id -u):$(id -g)" \
                                  -e SONAR_HOST_URL="$SONAR_HOST_URL" \
                                  -e SONAR_TOKEN="$SONAR_AUTH_TOKEN" \
                                  -e SONAR_USER_HOME=/usr/src/.sonar \
                                  -e SONAR_SCANNER_OPTS="-Xmx512m" \
                                  -v "$PWD:/usr/src" \
                                  sonarsource/sonar-scanner-cli \
                                  -Dsonar.projectKey=hr-frontend \
                                  -Dsonar.projectName="CorpFlow HR - Frontend" \
                                  -Dsonar.working.directory=/usr/src/.scannerwork \
                                  -Dsonar.scm.disabled=true \
                                  -Dsonar.javascript.node.maxspace=1024 \
                                  -Dsonar.sources=src \
                                  -Dsonar.exclusions="**/*.spec.ts,**/assets/**,**/environments/**"
                            '''
                        }
                        script { env.SONAR_ANALYSE_OK = 'true' }
                    }
                }
            }
        }

        stage('Quality Gate') {
            when { environment name: 'SONAR_ANALYSE_OK', value: 'true' }
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    timeout(time: 5, unit: 'MINUTES') {
                        waitForQualityGate abortPipeline: false
                    }
                }
            }
        }

        stage('Archivage du livrable') {
            steps {
                // Le site compilé est extrait de l'image de compilation, puis archivé dans Jenkins
                // (équivalent du WAR pour le backend)
                sh '''
                    rm -rf "$WORKSPACE/livrable" && mkdir -p "$WORKSPACE/livrable"
                    docker create --name "$BUILD_CONTAINER" "$BUILD_IMAGE"
                    docker cp "$BUILD_CONTAINER:/out/." "$WORKSPACE/livrable/"
                    docker rm "$BUILD_CONTAINER"
                    tar -czf "hr-frontend-$IMAGE_TAG.tar.gz" -C "$WORKSPACE/livrable" .
                '''
                archiveArtifacts artifacts: "hr-frontend-${env.IMAGE_TAG}.tar.gz", fingerprint: true
            }
        }

        stage('Image Docker') {
            steps {
                dir('hr-frontend') {
                    // Réutilise le cache de l'étape de compilation : Angular n'est pas recompilé
                    sh 'docker build -t "$IMAGE:$IMAGE_TAG" -t "$IMAGE:latest" .'
                }
            }
        }

        stage('Test de fumée') {
            steps {
                sh '''
                    docker run -d --name "$TEST_CONTAINER" "$IMAGE:$IMAGE_TAG"

                    for i in $(seq 1 15); do
                        if docker exec "$TEST_CONTAINER" wget -q -O /dev/null http://127.0.0.1:8080/; then
                            break
                        fi
                        sleep 1
                    done

                    docker exec "$TEST_CONTAINER" wget -q -O /dev/null http://127.0.0.1:8080/
                    docker exec "$TEST_CONTAINER" wget -q -O /dev/null http://127.0.0.1:8080/dashboard/leave
                    echo "Nginx sert la page d'accueil et les routes Angular"
                '''
            }
            post {
                failure {
                    sh 'docker logs "$TEST_CONTAINER" || true'
                }
                always {
                    sh 'docker rm -f "$TEST_CONTAINER" || true'
                }
            }
        }

        stage('Envoi vers Nexus') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'nexus-docker',
                                                  usernameVariable: 'NEXUS_USER',
                                                  passwordVariable: 'NEXUS_PWD')]) {
                    sh '''
                        echo "$NEXUS_PWD" | docker login "$REGISTRY" -u "$NEXUS_USER" --password-stdin
                        docker push -q "$IMAGE:$IMAGE_TAG"
                        docker push -q "$IMAGE:latest"
                    '''
                }
            }
        }

        stage('Déploiement Kubernetes') {
            steps {
                withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                    sh '''
                        kubectl -n hr-platform set image deployment/hr-frontend hr-frontend="$IMAGE:$IMAGE_TAG"
                        if ! kubectl -n hr-platform rollout status deployment/hr-frontend --timeout=180s; then
                            echo "Échec du déploiement : retour à la version précédente"
                            kubectl -n hr-platform rollout undo deployment/hr-frontend
                            exit 1
                        fi
                    '''
                }
            }
        }
    }

    post {
        always {
            sh 'docker logout "$REGISTRY" || true'
            sh 'docker rmi "$IMAGE:$IMAGE_TAG" "$IMAGE:latest" "$BUILD_IMAGE" 2>/dev/null || true'
            sh 'rm -rf "$WORKSPACE/livrable" "$WORKSPACE"/hr-frontend-*.tar.gz || true'
        }
        success {
            echo "Version ${env.IMAGE_TAG} compilée, analysée, testée, publiée et déployée"
        }
    }
}
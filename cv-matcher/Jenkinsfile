// =====================================================================
// Pipeline CI/CD du microservice IA (FastAPI, analyse CV / offre)
// Image Docker → tests et couverture dans l'image → qualité du code → Nexus → Kubernetes
// =====================================================================
pipeline {
    agent any

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
        timeout(time: 120, unit: 'MINUTES')   // 1er build long : PyTorch + modèle de langue
    }

    triggers {
        pollSCM('H/5 * * * *')
    }

    environment {
        REGISTRY       = '192.168.255.129:8082'
        IMAGE          = "${REGISTRY}/cv-matcher"
        IMAGE_TAG      = "${env.BUILD_NUMBER}"
        TEST_CONTAINER = "cv-matcher-tests-${env.BUILD_NUMBER}"
        SONAR_URL      = 'http://192.168.255.129:9000'
    }

    stages {

        stage('Image Docker') {
            steps {
                dir('cv-matcher') {
                    sh 'docker build -t "$IMAGE:$IMAGE_TAG" -t "$IMAGE:latest" .'
                }
            }
        }

        stage('Tests dans l\'image') {
            steps {
                dir('cv-matcher') {
                    // Les tests ne sont pas dans l'image : ils sont montés en lecture seule.
                    // pytest-cov mesure la couverture, lue ensuite par SonarQube.
                    sh '''
                        docker run --name "$TEST_CONTAINER" \
                          -v "$PWD/tests:/app/tests:ro" \
                          -e HF_HUB_OFFLINE=1 \
                          "$IMAGE:$IMAGE_TAG" \
                          sh -c "pip install -q --no-cache-dir pytest httpx pytest-cov && python -m pytest -q tests --junitxml=/tmp/pytest.xml --cov=app --cov-report=xml:/tmp/coverage.xml"
                    '''
                }
            }
            post {
                always {
                    sh '''
                        docker cp "$TEST_CONTAINER:/tmp/pytest.xml" cv-matcher/pytest.xml || true
                        docker cp "$TEST_CONTAINER:/tmp/coverage.xml" cv-matcher/coverage.xml || true
                        docker rm -f "$TEST_CONTAINER" || true
                        # Le rapport désigne /app (dans l'image) : on l'adapte au dossier analysé par SonarQube
                        sed -i 's#<source>/app</source>#<source>/usr/src</source>#' cv-matcher/coverage.xml || true
                    '''
                    junit allowEmptyResults: true, testResults: 'cv-matcher/pytest.xml'
                }
            }
        }

        stage('Vérification de SonarQube') {
            steps {
                script {
                    def code = sh(
                        script: "curl -sf ${SONAR_URL}/api/system/status | grep -q '\"status\":\"UP\"'",
                        returnStatus: true
                    )
                    env.SONAR_UP = (code == 0) ? 'true' : 'false'
                    echo(env.SONAR_UP == 'true'
                        ? 'SonarQube est disponible : analyse de la qualité du code'
                        : 'SonarQube est arrêté : analyse ignorée pour ce build')
                }
            }
        }

        stage('Analyse SonarQube') {
            when { environment name: 'SONAR_UP', value: 'true' }
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    dir('cv-matcher') {
                        withSonarQubeEnv('sonarqube') {
                            sh '''
                                docker run --rm \
                                  -u "$(id -u):$(id -g)" \
                                  -e SONAR_HOST_URL="$SONAR_HOST_URL" \
                                  -e SONAR_TOKEN="$SONAR_AUTH_TOKEN" \
                                  -e SONAR_USER_HOME=/tmp/.sonar \
                                  -v "$PWD:/usr/src" \
                                  sonarsource/sonar-scanner-cli \
                                  -Dsonar.projectKey=cv-matcher \
                                  -Dsonar.projectName="CorpFlow HR - Microservice IA" \
                                  -Dsonar.sources=app \
                                  -Dsonar.tests=tests \
                                  -Dsonar.python.version=3.11 \
                                  -Dsonar.python.coverage.reportPaths=coverage.xml
                            '''
                        }
                    }
                }
            }
        }

        stage('Quality Gate') {
            when { environment name: 'SONAR_UP', value: 'true' }
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: false
                }
            }
        }

        stage('Envoi vers Nexus') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'nexus-docker',
                                                  usernameVariable: 'NEXUS_USER',
                                                  passwordVariable: 'NEXUS_PWD')]) {
                    sh '''
                        echo "$NEXUS_PWD" | docker login "$REGISTRY" -u "$NEXUS_USER" --password-stdin
                        docker push -q "$IMAGE:$IMAGE_TAG"
                        docker push -q "$IMAGE:latest"
                    '''
                }
            }
        }

        stage('Déploiement Kubernetes') {
            steps {
                withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                    sh '''
                        kubectl -n hr-platform set image deployment/cv-matcher cv-matcher="$IMAGE:$IMAGE_TAG"
                        if ! kubectl -n hr-platform rollout status deployment/cv-matcher --timeout=900s; then
                            echo "Échec du déploiement : retour à la version précédente"
                            kubectl -n hr-platform rollout undo deployment/cv-matcher
                            exit 1
                        fi
                    '''
                }
            }
        }
    }

    post {
        always {
            sh 'docker logout "$REGISTRY" || true'
            sh 'docker rmi "$IMAGE:$IMAGE_TAG" "$IMAGE:latest" || true'
        }
        success {
            echo "Version ${IMAGE_TAG} testée, analysée, publiée et déployée"
        }
    }
}